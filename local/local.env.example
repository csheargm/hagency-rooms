# Copy to local/local.env (git-ignored) and set this server's repos. local/start.sh loads it.
# Never put passwords or tokens here: every agent process sees these values.
LOOP_REPO=you/hagency-demo-sandbox
HAGENCY_REPOS="you/hagency-hello"
# Only if you own every account whose agent runs on this computer: lets "Use it myself" run
# someone's own version here (it runs as this computer's account, with every agent's passwords).
# HAGENCY_CUSTOM_SHARED_OK=1
# Bring your own agent (remote_agent.py): what people's own computers reach. Defaults are this Mac's;
# a public server sets its https URLs (plain http is accepted only for localhost).
# HAGENCY_PUBLIC_HOMESERVER=https://matrix.example.org
# HAGENCY_PUBLIC_CONSOLE=https://rooms.example.org
