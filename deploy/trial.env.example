# Trial builds (docs/adr/0027-trial-builds.md, docs/TRIAL_BUILDER_SETUP.md). Copy to deploy/trial.env on the VM,
# `chmod 600 trial.env`, fill it in, then `sudo docker compose --env-file .env up -d trial-worker`.
# Only the trial-worker container gets this file. Builds are OFF unless E2B_API_KEY, TRIAL_APP_ID, the
# Trial App's key (deploy/trial-secrets/trial-app.pem), TRIAL_ORG and OLLAMA_API_KEY are all set.
#
# Kill switch: TRIAL_BUILD=off, then `sudo docker compose --env-file .env up -d --force-recreate trial-worker`
# (a plain restart keeps the old settings): our sandboxes are killed, waiting builds fail,
# "Try a build" disappears; the talk-only trial agent keeps working.
TRIAL_BUILD=on
# E2B (e2b.dev): a dedicated account with PREPAID credit and no card on file (the hard spend cap).
E2B_API_KEY=
# The E2B template every sandbox starts from (Python 3.12 with pytest, curl), and its fixed test command (pytest:
# the worker adds --junitxml and needs at least one passed test; -P keeps the repo from standing in for pytest).
TRIAL_E2B_TEMPLATE=hagency-trial-python
TRIAL_TEST_CMD=python -P -m pytest -q -p no:cacheprovider -o pythonpath=.
# The "Hagency Trial Builder" GitHub App (its numeric App ID), installed only on TRIAL_ORG.
TRIAL_APP_ID=
TRIAL_ORG=hagency-trials
# The demo repos in TRIAL_ORG (names, comma-separated), each made from the template, private.
TRIAL_REPOS=demo-1,demo-2,demo-3
# Ollama Cloud: this key's traffic shares ONE of the plan's 3 slots with the talk-only trial (talk first).
OLLAMA_API_KEY=
TRIAL_BUILD_MODEL=kimi-k2.7-code
TRIAL_MODELS=glm-5.3,kimi-k3.1-pro*2,kimi-k2.7-code,deepseek-v4.1-flash,gpt-oss:120b
# Builds pause at this share of the plan's period (all users of the key count) or this many tokens a month.
TRIAL_MAX_SHARE=0.7
TRIAL_MONTHLY_TOKENS=3000000
# Caps: the whole server per day; the queue; one build runs at a time. A person's own caps (free: 3 a day, 10 ever,
# per GitHub account) are their tier's (server/trial_tiers.py), not set here.
TRIAL_BUILDS_PER_DAY=20
TRIAL_BUILD_QUEUE=5
TRIAL_MIN_ACCOUNT_DAYS=30
# Matrix IDs that bypass the server's daily cap (the owner's demos), comma-separated.
TRIAL_BUILD_DEMO_USERS=
# One build: tool calls, seconds of tool loop, model tokens; E2B's own timeout; our sandbox time a day.
TRIAL_BUILD_STEPS=40
TRIAL_BUILD_S=600
TRIAL_BUILD_TOKENS=150000
TRIAL_SANDBOX_TIMEOUT_S=900
TRIAL_SANDBOX_S_PER_DAY=7200
TRIAL_LEASE_DAYS=7
