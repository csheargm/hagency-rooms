# The site (www.hagencylabs.xyz) is GitHub Pages (.github/workflows/pages.yml), not this server.

# Element Web (rooms.hagencylabs.xyz), plus @pm's console on the same name: the side panel, the
# console page (and its card scripts: panel.SCRIPTS), its sign-in and actions, and bring-your-own pairing (/connect, the Connect page
# /connect/start, and the installers /connect.sh and /connect.ps1), and invite links (/invite: docs/adr/0014).
{$ROOMS_DOMAIN} {
	handle /_synapse/admin* {
		respond 404
	}
	@pm path /panel /panel-agents.js /panel-project.js /panel-github.js /console /console/* /auth/* /connect /connect/* /connect.sh /connect.ps1 /invite /invite/*
	handle @pm {
		reverse_proxy pm:8650
	}
	# Hagency's home page for Element and its login logo and background (element_home.py writes them).
	# Only these three names: nothing else that might sit in the folder is ever served.
	@hagency path /hagency/home.html /hagency/logo.svg /hagency/background.svg
	handle @hagency {
		uri strip_prefix /hagency
		root * /srv/element-home
		header Cache-Control no-cache
		file_server
	}
	handle {
		header X-Frame-Options SAMEORIGIN   # Element itself is never framed by another site
		reverse_proxy element:80
	}
	# No X-Frame-Options for @pm's pages: the panel names the Element apps that may frame it in its own
	# Content-Security-Policy (panel.EMBEDDERS: Element Desktop is vector://vector), which X-Frame-Options
	# can't; the Connect page says frame-ancestors 'none' (connect_page.py).
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
	}
}

# Synapse (matrix.hagencylabs.xyz): client and federation APIs on 443, and the same on 8448
# (federation's default port, for servers that don't read .well-known).
# Admin APIs (/_synapse/admin) are never exposed to the internet.
{$MATRIX_DOMAIN}, {$MATRIX_DOMAIN}:8448 {
	handle /.well-known/matrix/server {
		header Content-Type application/json
		respond `{"m.server": "{$MATRIX_DOMAIN}:443"}`
	}
	handle /.well-known/matrix/client {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		respond `{"m.homeserver": {"base_url": "https://{$MATRIX_DOMAIN}"}}`
	}
	handle /_synapse/admin* {
		respond 404
	}
	# guard.py pauses media downloads (flags/media-paused) when this month's traffic nears the free 10 TB.
	@media_paused {
		path_regexp ^/_matrix/(media/[^/]+|client/v1/media|federation/v1/media)/(download|thumbnail)/
		file {
			root /flags
			try_files /media-paused
		}
	}
	handle @media_paused {
		respond "Media downloads are paused on this server for the rest of the month." 503
	}
	handle /_matrix* {
		reverse_proxy synapse:8008
	}
	handle /_synapse/client* {
		reverse_proxy synapse:8008
	}
	handle {
		respond 404
	}
}

# Synapse Admin (admin.hagencylabs.xyz): the only name that reaches /_synapse/admin. Its DNS record is
# proxied by Cloudflare and the owner's Cloudflare Access policy guards it, so here: only Cloudflare's
# addresses (vendored from https://www.cloudflare.com/ips-v4 and /ips-v6 on 2026-11-20; update them
# when Cloudflare's list changes), and only requests carrying an Access token. Caddy can't verify the
# token's signature without a plugin, so Access itself is what checks it (REVIEWS.md, review 22).
{$ADMIN_DOMAIN} {
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	@no_access_token not header Cf-Access-Jwt-Assertion *
	route {                           # in this order, as written: the refusals come first
		respond @not_cloudflare 403
		respond @no_access_token 403
		reverse_proxy /_matrix* synapse:8008
		reverse_proxy /_synapse/admin* synapse:8008
		reverse_proxy synapse-admin:8080   # the etke image listens on 8080 (seen live: 502 on :80)
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
	}
}
